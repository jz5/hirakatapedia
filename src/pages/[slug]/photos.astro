---
/**
 * 関連写真（/<記事>/photos/）。記事のために選んだ写真（記事に使った写真も、使わなかった写真も）を、記事に合わせた説明つきで並べる。
 * サイト全体の写真ギャラリー（/gallery/、「枚方の写真」）とは別。記事の中の場所の写真の欄（<div data-gallery>）は、そちらへつなぐ。
 * 一覧は content/galleries/<記事>.yaml（hide のものは出さない）。使うときの条件の説明は /gallery/#use にまとめている
 */
import { allArticles, articlePath } from "../../lib/articles";
import { publicGallery, galleryPath } from "../../lib/photos.mjs";
import PhotoCard from "../../components/PhotoCard.astro";
import Base from "../../layouts/Base.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const getStaticPaths = (async () => {
  const list = await allArticles();
  return list
    .map((entry) => ({ entry, photos: publicGallery(entry.id) }))
    .filter((x) => x.photos.length > 0)
    .map(({ entry, photos }) => ({ params: { slug: entry.id }, props: { entry, photos } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, photos } = Astro.props as Props;
const d = entry.data;
const title = `関連写真：${d.title}`;
---

<Base
  title={title}
  description={`記事「${d.title}」に関係する写真 ${photos.length}枚。条件を守ればだれでも使える写真です。`}
  path={galleryPath(entry.id)}
  image={photos[0].large.src}
  source={`content/galleries/${entry.id}.yaml`}
>
  <article class="entry">
    <header class="entry-header">
      <p class="gallery-back"><a href={articlePath(entry.id)}>← 記事に戻る</a></p>
      <h1>関連写真（{photos.length}枚）</h1>
      <p class="entry-meta">記事「<a href={articlePath(entry.id)}>{d.title}</a>」に関係する写真です。</p>
    </header>

    <div class="entry-body">
      <p class="gallery-note">
        どれも、条件を守ればだれでも使える写真です（<a href="/gallery/#use">使うときの条件</a>）。それぞれの「〜で見る」から、元の画像とくわしい条件を確かめてください。
      </p>

      <ul class="gallery-grid">
        {photos.map((p) => <PhotoCard p={p} />)}
      </ul>
    </div>
  </article>
</Base>
