---
import { render } from "astro:content";
import { allArticles, articlePath, jaDate, lastModified } from "../lib/articles";
import Base from "../layouts/Base.astro";
import ArticleBody from "../components/ArticleBody.astro";
import Toc from "../components/Toc.astro";
import { photo } from "../lib/photos.mjs";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

/** URL はファイル名（entry.id）。tsutaya.md → /tsutaya/ */
export const getStaticPaths = (async () => {
  const list = await allArticles();
  return list.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const d = entry.data;
const { Content, headings } = await render(entry);
// 事典なので、いつ書いたかより、いつの情報かを出す
const last = lastModified(entry);
// frontmatter の cover は og:image にだけ使う（本文には出さない）。無ければ本文の最初の写真を使う
const coverFile = d.cover ?? entry.body?.match(/<div\b[^>]*\bdata-photo="([^"]+)"/)?.[1]?.split("|")[0];
const cover = coverFile ? photo(entry.id, coverFile) : undefined;
const path = articlePath(entry.id);
const breadcrumbs = [
  { name: "ホーム", path: "/" },
  { name: d.title, path },
];
---

<Base
  title={d.title}
  description={d.description}
  path={path}
  article={{ published: d.published, modified: last > d.published ? last : undefined }}
  image={cover?.large.src}
  source={`content/articles/${entry.id}.md`}
  breadcrumbs={breadcrumbs}
>
  <article class="entry" data-pagefind-body>
    <header class="entry-header">
      <h1>{d.title}</h1>
      <p class="entry-meta" data-pagefind-ignore>最終更新 <time datetime={last.toISOString().slice(0, 10)}>{jaDate(last)}</time></p>
    </header>



    {/* 目次は 2 か所に置く。広い画面では右の列（slot="toc"）、それ以外は題名の下 */}
    <div class="toc-inline" data-pagefind-ignore><Toc headings={headings} inline /></div>

    <ArticleBody><Content /></ArticleBody>

    <footer class="entry-footer" data-pagefind-ignore>
      <p>公開 <time datetime={d.published.toISOString().slice(0, 10)}>{jaDate(d.published)}</time>・最終更新 <time datetime={last.toISOString().slice(0, 10)}>{jaDate(last)}</time></p>
    </footer>
  </article>

  <Toc slot="toc" headings={headings} />
</Base>
