---
import { render } from "astro:content";
import { allArticles, articlePath, jaDate } from "../lib/articles";
import Base from "../layouts/Base.astro";
import ArticleBody from "../components/ArticleBody.astro";
import Toc from "../components/Toc.astro";
import { photo } from "../lib/photos.mjs";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

/** URL はファイル名（entry.id）。tsutaya.md → /tsutaya/ */
export const getStaticPaths = (async () => {
  const list = await allArticles();
  return list.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const d = entry.data;
const { Content, headings } = await render(entry);
// 事典なので、いつ書いたかより、いつの情報かを出す
const last = d.updated ?? d.published;
// frontmatter の cover は og:image にだけ使う（本文には出さない）
const cover = d.cover ? photo(entry.id, d.cover) : undefined;
---

<Base
  title={d.title}
  description={d.description}
  path={articlePath(entry.id)}
  article={{ published: d.published, modified: d.updated }}
  image={cover?.large.src}
  source={`content/articles/${entry.id}.md`}
>
  <article class="entry" data-pagefind-body>
    <header class="entry-header">
      <h1>{d.title}</h1>
      <p class="entry-meta" data-pagefind-ignore>最終更新 <time datetime={last.toISOString()}>{jaDate(last)}</time></p>
    </header>



    {/* 目次は 2 か所に置く。広い画面では右の列（slot="toc"）、それ以外は題名の下 */}
    <div class="toc-inline" data-pagefind-ignore><Toc headings={headings} inline /></div>

    <ArticleBody><Content /></ArticleBody>

    <footer class="entry-footer" data-pagefind-ignore>
      <p>
        公開 <time datetime={d.published.toISOString().slice(0, 10)}>{jaDate(d.published)}</time>
        {d.updated && <>・最終更新 <time datetime={d.updated.toISOString().slice(0, 10)}>{jaDate(d.updated)}</time></>}
      </p>
    </footer>
  </article>

  <Toc slot="toc" headings={headings} />
</Base>
