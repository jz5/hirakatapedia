---
import { allArticles, articlePath, lastModified, jaDate } from "../lib/articles";
import { articleStats } from "../lib/article-stats";
import { SITE } from "../lib/site";
import Base from "../layouts/Base.astro";
import { photo } from "../lib/photos.mjs";

const list = await allArticles();
// アイキャッチ（frontmatter の cover）の小さい画像。cover がない記事は、本文の最初の写真。どちらもなければ文字だけ
const thumb = (e: (typeof list)[number]) => {
  const file = e.data.cover ?? e.body?.match(/<div data-photo="([^"]+)"><\/div>/)?.[1];
  return file ? photo(e.id, file) : undefined;
};
---

<Base path="/">
  <section class="hero">
    {/* サイト名はヘッダーにあるので、見出しは読み上げ用にだけ置く */}
    <h1 class="visually-hidden">{SITE.title}（{SITE.reading}）</h1>
    <p class="hero-lead">{SITE.description}</p>
    <p class="hero-sub">「それ、どこに書いてあるの？」と聞かれても答えられるように、ひとつひとつの話に出典を付けています。</p>
  </section>

  <h2 class="visually-hidden">記事</h2>
  <ul class="card-list">
    {
      list.map((e) => {
        const stats = articleStats(e.body);
        const t = thumb(e);
        return (
          <li>
            <a href={articlePath(e.id)} class:list={[{ "has-thumb": !!t }]}>
              {t && (
                <img class="card-thumb" src={t.small.src} width={t.small.width} height={t.small.height} alt="" loading="lazy" decoding="async" />
              )}
              <span class="card-text">
                <span class="card-title">{e.data.title}</span>
                <span class="card-desc">{e.data.description}</span>
                <span class="card-date"><span class="meta-item">更新 <time datetime={lastModified(e).toISOString().slice(0, 10)}>{jaDate(lastModified(e))}</time></span>{stats.sources > 0 && <span class="meta-item">・出典・注釈 {stats.sources}件</span>}{stats.charts > 0 && <span class="meta-item">・グラフ {stats.charts}件</span>}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
