---
import { allArticles, articlePath, lastModified, jaDate } from "../lib/articles";
import { SITE } from "../lib/site";
import Base from "../layouts/Base.astro";
import { photo } from "../lib/photos.mjs";

const list = await allArticles();
// アイキャッチ（frontmatter の cover）の小さい画像。cover がない記事は、本文の最初の写真。どちらもなければ文字だけ
const thumb = (e: (typeof list)[number]) => {
  const file = e.data.cover ?? e.body?.match(/<div data-photo="([^"]+)"><\/div>/)?.[1];
  return file ? photo(e.id, file) : undefined;
};
---

<Base path="/">
  <section class="hero">
    {/* サイト名はヘッダーにあるので、見出しは読み上げ用にだけ置く */}
    <h1 class="visually-hidden">{SITE.title}（{SITE.reading}）</h1>
    <p class="hero-lead">{SITE.description}</p>
    <p class="hero-sub">「それ、どこに書いてあるの？」と聞かれても答えられるように、ひとつひとつの話に出典を付けています。</p>
  </section>

  <h2 class="visually-hidden">記事</h2>
  <ul class="card-list">
    {
      list.map((e) => (
        <li>
          <a href={articlePath(e.id)} class:list={[{ "has-thumb": !!thumb(e) }]}>
            {thumb(e) && (
              <img class="card-thumb" src={thumb(e)!.small.src} width={thumb(e)!.small.width} height={thumb(e)!.small.height} alt="" loading="lazy" decoding="async" />
            )}
            <span class="card-text">
              <span class="card-title">{e.data.title}</span>
              <span class="card-desc">{e.data.description}</span>
              <span class="card-date">更新 <time datetime={lastModified(e).toISOString().slice(0, 10)}>{jaDate(lastModified(e))}</time></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
