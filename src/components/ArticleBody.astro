---
/** 記事の本文の入れ物。中身は呼び出し側で render() したものを slot で受け取る */
---

<div class="entry-body"><slot /></div>

<script>
  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  /* 脚注の番号にマウスを乗せたら、出典の中身を吹き出しで出す。
     PC では押せば下の一覧へ飛ぶ。タッチ端末では 1 回目のタップで吹き出しを出し、
     吹き出しの中のリンクから一覧へ飛べるようにする（その場で出典を読めるように） */
  const refs = document.querySelectorAll<HTMLAnchorElement>(".entry-body a[data-footnote-ref]");
  if (refs.length > 0) {
    const tip = document.createElement("div");
    tip.className = "footnote-tip";
    tip.setAttribute("role", "tooltip");
    tip.hidden = true;
    document.body.append(tip);

    let timer: number | undefined;
    let activeRef: HTMLAnchorElement | null = null;
    const isTouch = () => matchMedia("(hover: none), (pointer: coarse)").matches;
    const hideNow = () => {
      window.clearTimeout(timer);
      tip.hidden = true;
      activeRef = null;
    };
    const hide = () => {
      timer = window.setTimeout(hideNow, 200);
    };
    const keep = () => window.clearTimeout(timer);

    const show = (ref: HTMLAnchorElement, touchMode = false) => {
      keep();
      const targetId = decodeURIComponent(ref.hash.slice(1));
      const li = document.getElementById(targetId);
      if (!li) return;
      const body = li.cloneNode(true) as HTMLElement;
      body.querySelectorAll("[data-footnote-backref]").forEach((a) => a.remove());
      tip.innerHTML = body.innerHTML;
      if (touchMode) {
        const jump = document.createElement("p");
        jump.className = "footnote-tip-jump";
        const a = document.createElement("a");
        a.href = ref.hash;
        a.textContent = "出典・注釈の一覧へ移動";
        a.addEventListener("click", hideNow);
        jump.append(a);
        tip.append(jump);
      }
      tip.hidden = false;
      activeRef = ref;

      // 番号の下に出す。画面の下にはみ出すなら上に出す
      const r = ref.getBoundingClientRect();
      const w = tip.offsetWidth;
      const left = Math.max(8, Math.min(r.left + window.scrollX - w / 2, window.scrollX + document.documentElement.clientWidth - w - 8));
      const below = r.bottom + 6 + tip.offsetHeight <= window.innerHeight;
      const top = below ? r.bottom + window.scrollY + 6 : r.top + window.scrollY - tip.offsetHeight - 6;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };

    for (const ref of refs) {
      ref.addEventListener("mouseenter", () => { if (!isTouch()) show(ref, false); });
      ref.addEventListener("focus", () => { if (!isTouch()) show(ref, false); });
      ref.addEventListener("mouseleave", () => { if (!isTouch()) hide(); });
      ref.addEventListener("blur", () => { if (!isTouch()) hide(); });
      ref.addEventListener("click", (e) => {
        if (!isTouch()) return;
        e.preventDefault();
        if (!tip.hidden && activeRef === ref) hideNow();
        else show(ref, true);
      });
    }
    tip.addEventListener("mouseenter", keep);
    tip.addEventListener("mouseleave", () => { if (!isTouch()) hide(); });
    document.addEventListener("click", (e) => {
      if (tip.hidden) return;
      const t = e.target as Node;
      if (tip.contains(t) || (activeRef && activeRef.contains(t))) return;
      hideNow();
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") hideNow(); });
  }

  /* グラフにマウスを乗せたら（タッチ端末ではタップ）、最も近い年に縦線を引いて、その年の数字を吹き出しで出す。
     データは SVG の data-chart（src/lib/charts.mjs が埋め込む） */
  for (const svg of document.querySelectorAll<SVGSVGElement>("svg[data-chart]")) {
    type Row = { x: number; px: number; v: { n: string; c: string | number; y: number; t?: string }[] };
    const d = JSON.parse(svg.dataset.chart!) as { unit: string; plot: { top: number; bottom: number; width: number; height: number }; rows: Row[] };
    if (!d.rows?.length) continue;
    const box = svg.parentElement!;
    const ns = "http://www.w3.org/2000/svg";
    const cursor = document.createElementNS(ns, "line");
    cursor.setAttribute("class", "chart-cursor");
    cursor.setAttribute("y1", String(d.plot.top));
    cursor.setAttribute("y2", String(d.plot.bottom));
    cursor.style.display = "none";
    svg.appendChild(cursor);
    const tip = document.createElement("div");
    tip.className = "chart-tip";
    tip.hidden = true;
    box.appendChild(tip);
    const color = (c: string | number) => (c === "mut" ? "var(--mut)" : `var(--chart-${Number(c) === 2 ? 2 : 1})`);

    const show = (clientX: number) => {
      const rect = svg.getBoundingClientRect();
      if (!rect.width) return;
      const px = ((clientX - rect.left) / rect.width) * d.plot.width;
      let best = d.rows[0];
      for (const r of d.rows) if (Math.abs(r.px - px) < Math.abs(best.px - px)) best = r;
      cursor.setAttribute("x1", String(best.px));
      cursor.setAttribute("x2", String(best.px));
      cursor.style.display = "";
      tip.innerHTML =
        `<b>${esc(best.x)}年</b>` +
        best.v
          .map((v) => `<br><i style="background:${color(v.c)}"></i>${esc(v.n)}　${esc(v.t ?? v.y.toLocaleString("ja-JP") + d.unit)}`)
          .join("");
      tip.hidden = false;
      const x = (best.px / d.plot.width) * rect.width + rect.left - box.getBoundingClientRect().left + box.scrollLeft;
      const left = x + 12 + tip.offsetWidth > box.scrollLeft + box.clientWidth ? x - 12 - tip.offsetWidth : x + 12;
      tip.style.left = `${Math.max(0, left)}px`;
      tip.style.top = `${(d.plot.top / d.plot.height) * rect.height}px`;
    };
    const hide = () => {
      cursor.style.display = "none";
      tip.hidden = true;
    };
    svg.addEventListener("pointermove", (e) => { if (e.pointerType !== "touch") show(e.clientX); });
    svg.addEventListener("pointerdown", (e) => { if (e.pointerType === "touch") show(e.clientX); });
    svg.addEventListener("pointerleave", (e) => { if (e.pointerType !== "touch") hide(); });
    document.addEventListener("pointerdown", (e) => {
      if (!tip.hidden && !box.contains(e.target as Node)) hide();
    });
  }
</script>
