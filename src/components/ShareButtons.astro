---
/**
 * このページを SNS で共有するボタン（右の列）。X・Misskey・Mastodon・Bluesky・Threads・LINE と、リンクのコピー。
 * アイコン：Font Awesome Free（Icons: CC BY 4.0）。Misskey は misskey-dev/assets の mi.svg（CC BY-SA 4.0）を色だけ変えて使う。
 * LINE のアイコンは枠いっぱいの形で小さく見えるので、ほかより大きく出す（share-big）。表示は /license/ に書いている
 */
import xSvg from "@fortawesome/fontawesome-free/svgs/brands/x-twitter.svg?raw";
import mastodonSvg from "@fortawesome/fontawesome-free/svgs/brands/mastodon.svg?raw";
import blueskySvg from "@fortawesome/fontawesome-free/svgs/brands/bluesky.svg?raw";
import threadsSvg from "@fortawesome/fontawesome-free/svgs/brands/threads.svg?raw";
import lineSvg from "@fortawesome/fontawesome-free/svgs/brands/line.svg?raw";
import linkSvg from "@fortawesome/fontawesome-free/svgs/solid/link.svg?raw";

interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
const icon = (svg: string) => ({
  viewBox: svg.match(/viewBox="([^"]+)"/)![1],
  d: [...svg.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]).join(" "),
});
const q = (o: Record<string, string>) => new URLSearchParams(o).toString();
const text = `${title}\n${url}`;
const items = [
  { name: "X", href: `https://x.com/intent/post?${q({ text: title, url })}`, svg: icon(xSvg) },
  { name: "Misskey", href: `https://misskey-hub.net/share/?${q({ text, visibility: "public", localOnly: "0" })}`, mi: true },
  { name: "Mastodon", href: `https://pronama.jp/share-to-mastodon.html?${q({ text })}`, svg: icon(mastodonSvg) },
  { name: "Bluesky", href: `https://bsky.app/intent/compose?${q({ text })}`, svg: icon(blueskySvg) },
  { name: "Threads", href: `https://www.threads.net/intent/post?${q({ text })}`, svg: icon(threadsSvg) },
  { name: "LINE", href: `https://social-plugins.line.me/lineit/share?${q({ url, text: title })}`, svg: icon(lineSvg), big: true },
];
const link = icon(linkSvg);
---

<section class="share" aria-label="このページを共有">
  <p class="share-title">このページを共有</p>
  <ul class="share-list">
    {
      items.map((it) => (
        <li>
          <a href={it.href} target="_blank" rel="noopener" aria-label={`${it.name}で共有`} title={`${it.name}で共有`}>
            {it.mi ? (
              <span class="share-mi" aria-hidden="true" />
            ) : (
              <svg class={it.big ? "share-big" : undefined} viewBox={it.svg!.viewBox} aria-hidden="true" focusable="false"><path d={it.svg!.d} /></svg>
            )}
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" class="share-copy" data-url={url} aria-label="リンクをコピー" title="リンクをコピー">
        <svg viewBox={link.viewBox} aria-hidden="true" focusable="false"><path d={link.d} /></svg>
      </button>
    </li>
  </ul>
  <p class="share-copied" role="status" aria-live="polite" hidden>リンクをコピーしました</p>
</section>

<script>
  // リンクをコピー（ページの URL）。できたら下に「コピーしました」を少しのあいだ出す
  for (const b of document.querySelectorAll<HTMLButtonElement>(".share-copy")) {
    const msg = b.closest(".share")?.querySelector<HTMLElement>(".share-copied");
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url ?? location.href);
        if (msg) msg.textContent = "リンクをコピーしました";
      } catch {
        if (msg) msg.textContent = "コピーできませんでした";
      }
      if (msg) {
        msg.hidden = false;
        setTimeout(() => (msg.hidden = true), 2500);
      }
    });
  }
</script>
