---
import { SITE, LICENSE, OPERATOR, AUTHOR } from "../lib/site";
import ThemeSelect from "../components/ThemeSelect.astro";
import Sidebar from "../components/Sidebar.astro";
import githubSvg from "@fortawesome/fontawesome-free/svgs/brands/github.svg?raw";
import searchSvg from "@fortawesome/fontawesome-free/svgs/solid/magnifying-glass.svg?raw";
import Analytics from "../components/Analytics.astro";
// 本文の書体（LINE Seed JP）。自分のサーバーから配る（Google Fonts から読まない）
import "@fontsource/line-seed-jp/400.css";
import "@fontsource/line-seed-jp/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** 正規 URL のパス */
  path: string;
  /** 記事のとき、構造化データと og:article:* に使う */
  article?: { published: Date; modified?: Date };
  noindex?: boolean;
  /** og:image にする画像のパス（/photos/… の大きい jpg）か URL。無ければサイト共通の画像（/og.png） */
  image?: string;
  /** 右の列（サイドバー）なしの、広い 1 列。表の大きいページ（SNS・データ）に使う */
  wide?: boolean;
  /** このページのもとになっているファイル（リポジトリの中のパス）。フッターの GitHub のアイコンを、そのファイルの変更の履歴へのリンクにする */
  source?: string;
  /** ページごとの構造化データ（写真のページの ImageObject など）。記事の Article とホームの WebSite はここで作る */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, article, noindex = false, image, wide = false, source, jsonLd: pageLd } = Astro.props;
const hasToc = Astro.slots.has("toc");

const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}（${SITE.reading}）`;
const desc = description || SITE.description;
const canonical = new URL(path, SITE.url).href;
// フッターの GitHub のアイコン。ページのもとのファイルが分かれば、そのファイルの変更の履歴へ、分からなければリポジトリへ
const REPO = "https://github.com/jz5/hirakatapedia";
const SOURCES: Record<string, string> = {
  "/": "src/pages/index.astro",
  "/about/": "src/pages/about.astro",
  "/privacy/": "src/pages/privacy.astro",
  "/license/": "src/pages/license.astro",
  "/sns/": "content/data/sns.yaml",
  "/gallery/": "src/pages/gallery/index.astro",
  "/gallery/contribute/": "src/pages/gallery/contribute.astro",
  "/data/": "src/pages/data/index.astro",
  "/data/gomi/": "src/pages/data/gomi.astro",
  "/data/city/": "src/pages/data/city.astro",
  "/data/links/": "src/pages/data/links.astro",
};
const sourceFile = source ?? SOURCES[path];
const githubUrl = sourceFile ? `${REPO}/commits/main/${sourceFile}` : REPO;
const githubLabel = sourceFile ? "GitHub（このページの変更の履歴）" : "GitHub（記事とプログラム）";
// アイコンは Font Awesome Free（Icons: CC BY 4.0）
const github = { viewBox: githubSvg.match(/viewBox="([^"]+)"/)![1], d: githubSvg.match(/<path d="([^"]+)"/)![1] };
const searchIcon = { viewBox: searchSvg.match(/viewBox="([^"]+)"/)![1], d: searchSvg.match(/<path d="([^"]+)"/)![1] };

// SNS で共有したときの画像。ページの画像（記事の cover・写真）が無いときは、サイト共通の画像（public/og.png。scripts/og-image.mjs で作る）
const ogImage = new URL(image ?? "/og.png", SITE.url).href;
// frontmatter の日付は「日本の日付」なので、日本時間の 0 時として書く（UTC の 0 時だと日本の朝 9 時になる）
const jst = (d: Date) => `${d.toISOString().slice(0, 10)}T00:00:00+09:00`;
const publisher = { "@type": "Organization", name: OPERATOR.name, alternateName: OPERATOR.nameEn, url: OPERATOR.url };
const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      headline: title,
      description: desc,
      ...(image ? { image: ogImage } : {}),
      datePublished: jst(article.published),
      dateModified: jst(article.modified ?? article.published),
      author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
      publisher,
      license: LICENSE.url,
      inLanguage: SITE.lang,
    }
  : path === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        alternateName: SITE.reading,
        url: SITE.url,
        description: desc,
        inLanguage: SITE.lang,
        publisher,
        license: LICENSE.url,
        potentialAction: {
          "@type": "SearchAction",
          target: { "@type": "EntryPoint", urlTemplate: `${SITE.url.replace(/\/$/, "")}/search/?q={search_term_string}` },
          "query-input": "required name=search_term_string",
        },
      }
    : pageLd
      ? { "@context": "https://schema.org", ...pageLd }
      : null;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 描画前に配色を決める。これが無いとリロードのたびに一瞬白く光る。 -->
    <script is:inline>
      try {
        const v = localStorage.getItem("hirakatapedia-theme");
        if (v === "light" || v === "dark") document.documentElement.setAttribute("data-theme", v);
      } catch {}
    </script>
    <meta name="color-scheme" content="light dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="license" href={LICENSE.url} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title || SITE.title} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="ja_JP" />
    {article && <meta property="article:published_time" content={jst(article.published)} />}
    {article?.modified && <meta property="article:modified_time" content={jst(article.modified)} />}
    <meta property="og:image" content={ogImage} />
    {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="site-brand" href="/">
          <span class="site-name"><span class="site-name-ja">枚方</span><span class="site-name-en">pedia</span></span>
          <span class="site-reading" data-reading>{SITE.reading}</span>
        </a>
        <nav class="site-nav" aria-label="サイト">
          <a href="/gallery/">写真</a>
          <a href="/data/">データ</a>
          <a href="/sns/">SNS</a>
          <a href="/about/">このサイトについて</a>
          <a href="/search/" class="site-nav-search" aria-label="記事の検索" title="記事の検索"><svg viewBox={searchIcon.viewBox} aria-hidden="true" focusable="false"><path d={searchIcon.d} /></svg></a>
        </nav>
        <ThemeSelect />
      </div>
    </header>
    <script is:inline>
      // 4月1日（日本時間）だけ、ヘッダーの読みを「まいかたペディア」にする（エイプリルフール）
      (() => {
        const d = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Tokyo", month: "numeric", day: "numeric" }).format(new Date());
        if (d === "4/1") {
          const el = document.querySelector("[data-reading]");
          if (el) el.textContent = el.textContent.replace("ひらかた", "まいかた");
        }
      })();
    </script>

    <div class:list={["wrap layout", { "layout-wide": wide }]}>
      <main id="main" class="layout-main">
        <slot />
      </main>
      {!wide && <Sidebar home={path === "/"} shareTitle={fullTitle} shareUrl={canonical}>{hasToc && <slot name="toc" />}</Sidebar>}
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-license">
          記事は <a href="/license/" rel="license">{LICENSE.name}</a> で利用できます。引用した資料や写真は、それぞれの権利者のものです。
        </p>
        <p class="footer-links">
          <a href="/about/">このサイトについて</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/license/">ライセンス</a>
        </p>
        {/* 年は毎年直すのを忘れるのでビルド時に入れる */}
        <p class="copyright"><span>© {new Date().getFullYear() > 2026 ? `2026-${new Date().getFullYear()}` : "2026"} {OPERATOR.nameEn}</span><a href={githubUrl} class="footer-github" aria-label={githubLabel} title={githubLabel}><svg viewBox={github.viewBox} aria-hidden="true" focusable="false"><path d={github.d} /></svg></a></p>
      </div>
    </footer>
  </body>
</html>
