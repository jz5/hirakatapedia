---
import { SITE, LICENSE } from "../lib/site";
import ThemeSelect from "../components/ThemeSelect.astro";
import Sidebar from "../components/Sidebar.astro";
import Analytics from "../components/Analytics.astro";
// 本文の書体（LINE Seed JP）。自分のサーバーから配る（Google Fonts から読まない）
import "@fontsource/line-seed-jp/400.css";
import "@fontsource/line-seed-jp/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** 正規 URL のパス */
  path: string;
  /** 記事のとき、構造化データと og:article:* に使う */
  article?: { published: Date; modified?: Date };
  noindex?: boolean;
  /** 書きかけの記事 */
  wip?: boolean;
}

const { title, description, path, article, noindex = false, wip = false } = Astro.props;
const hasToc = Astro.slots.has("toc");

const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}（${SITE.reading}）`;
const desc = description || SITE.description;
const canonical = new URL(path, SITE.url).href;

const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      headline: title,
      description: desc,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author: { "@type": "Person", name: "jz5", url: "https://jz5.jp/" },
      publisher: { "@type": "Organization", name: SITE.title, url: SITE.url },
      license: LICENSE.url,
    }
  : null;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 描画前に配色を決める。これが無いとリロードのたびに一瞬白く光る。 -->
    <script is:inline>
      try {
        const v = localStorage.getItem("hirakatapedia-theme");
        if (v === "light" || v === "dark") document.documentElement.setAttribute("data-theme", v);
      } catch {}
    </script>
    <meta name="color-scheme" content="light dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="license" href={LICENSE.url} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title || SITE.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="ja_JP" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="site-brand" href="/">
          <span class="site-name"><span class="site-name-ja">枚方</span><span class="site-name-en">pedia</span></span>
          <span class="site-reading">{SITE.reading}</span>
        </a>
        <nav class="site-nav" aria-label="サイト">
          <a href="/about/">このサイトについて</a>
          <ThemeSelect />
        </nav>
      </div>
    </header>

    <div class="wrap layout">
      <main id="main" class="layout-main">
        <slot />
      </main>
      <Sidebar wip={wip}>{hasToc && <slot name="toc" />}</Sidebar>
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-license">
          記事は <a href="/license/" rel="license">{LICENSE.name}</a> で利用できます。引用した資料や写真は、それぞれの権利者のものです。
        </p>
        <p class="footer-links">
          <a href="/about/">このサイトについて</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/license/">ライセンス</a>
        </p>
        {/* 年は毎年直すのを忘れるのでビルド時に入れる */}
        <p class="copyright">© {new Date().getFullYear() > 2026 ? `2026-${new Date().getFullYear()}` : "2026"} jz5</p>
      </div>
    </footer>
  </body>
</html>
