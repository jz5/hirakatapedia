---
/** 国立国会図書館・図書館で見るもの（docs/ndl.md）を見るページ。/admin/ と同じく開発サーバーだけ */
import Base from "../layouts/Base.astro";

const docs = import.meta.glob<{ Content: any }>("../../docs/ndl.md", { eager: true });
const Content = Object.values(docs)[0]?.Content;
const raw =
  Object.values(import.meta.glob<string>("../../docs/ndl.md", { query: "?raw", import: "default", eager: true }))[0] ?? "";
const open = (raw.match(/^\s*- \[ \]/gm) ?? []).length;
---

<Base title="図書館で見るもの" path="/admin/ndl/" noindex>
  <article class="entry">
    <header class="entry-header">
      <p class="entry-meta"><a href="/admin/" class="ar-l">管理者ページ</a>（docs/ndl.md）。まだ {open} 件</p>
    </header>
    <div class="entry-body admin">{Content ? <Content /> : <p>docs/ndl.md がありません。</p>}</div>
  </article>
</Base>
