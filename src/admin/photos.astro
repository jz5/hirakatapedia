---
/**
 * 管理者用ページ（/admin/photos/）。写真の一覧（content/galleries/*.yaml）を、hide のものやメモも含めて並べる。
 * 公開する写真ギャラリーは /<記事>/photos/。写真を足すときは yaml に書いて node scripts/photos.mjs
 */
import Base from "../layouts/Base.astro";
import { allArticles, articlePath } from "../lib/articles";
import { gallery, gallerySlugs, galleryPath, licenseLabel } from "../lib/photos.mjs";

type Photo = ReturnType<typeof gallery>[number];
type Group = { slug: string; label?: string; list: Photo[] };
type Source = { name: string; url: string; license: string; note: string };

const articles = Object.fromEntries((await allArticles()).map((e) => [e.id, e.data.title]));
const groups: Group[] = gallerySlugs().map((slug) => ({ slug, label: articles[slug] ? undefined : `${slug}（記事はまだ）`, list: gallery(slug) }));
const titles = articles;

/** Commons 以外で使えるところ（くわしくは docs/notes/images-non-commons.md） */
const sources: Source[] = [
  { name: "枚方市 オープンデータ画像集", url: "https://www.city.hirakata.osaka.jp/0000021947.html", license: "CC BY 2.1 JP（改変できる）", note: "公園、桜の名所、牧野車塚古墳、観光ステーション（全63枚）。図書館と駅前はない" },
  { name: "枚方市 文化財画像データ", url: "https://www.city.hirakata.osaka.jp/0000047672.html", license: "CC BY-ND 2.1 JP（改変できない）", note: "百済寺跡、楠葉台場跡、旧田中家鋳物民俗資料館、田中邸のむく、鍵屋。トリミングもしない" },
  { name: "国立国会図書館 電子展示会「錦絵と写真でめぐる日本の名所」枚方", url: "https://www.ndl.go.jp/landmarks/sights/hirakata", license: "自由に使える（保護期間満了）", note: "「六十余州名所図会 河内 枚方男山」など。淀川のページもある" },
  { name: "NDLイメージバンク", url: "https://www.ndl.go.jp/imagebank", license: "自由に使える（保護期間満了）", note: "出典の記載をお願いされている" },
  { name: "国土地理院 地図・空中写真閲覧サービス", url: "https://service.gsi.go.jp/map-photos/app/help", license: "出典を書けば使える", note: "1945〜50年、1961〜69年、1974〜78年、1979〜83年、1984〜86年の空中写真。昔といまの比べっこに" },
  { name: "使えないもの", url: "https://www.city.hirakata.osaka.jp/0000010379.html", license: "無断転用禁止", note: "市のサイト一般、広報ひらかた、大阪府のサイト、文化遺産オンライン。市史資料室の古写真は申し込みが必要" },
];
const count = groups.reduce((n, g) => n + g.list.length, 0);
---

<Base title="写真の候補" path="/admin/photos/" noindex>
  <article class="entry">
    <header class="entry-header">
      <h1>写真の候補（自由ライセンス）</h1>
      <p class="entry-meta">
        開発サーバーだけで見えるページです（公開されません）。Wikimedia Commons の写真 {count}枚。★ はいちばん使えそうなもの、「見た」は画像を見て確かめたもの。
        <a href="/admin/">管理者ページに戻る</a>
      </p>
    </header>
    <div class="entry-body">
      <nav>
        <ul class="cc-toc">
          {groups.map((g) => <li><a href={`#${g.slug}`}>{g.label ?? titles[g.slug] ?? g.slug}</a></li>)}
          <li><a href="#sources">Commons 以外</a></li>
        </ul>
      </nav>
      {
        groups.map((g) => (
          <section id={g.slug}>
            <h2>{g.label ? g.label : <a href={articlePath(g.slug)}>{titles[g.slug] ?? g.slug}</a>}</h2>
            {!g.label && <p><a href={galleryPath(g.slug)}>公開している「この記事の写真」</a></p>}
            <ul class="cc-grid">
              {g.list.map((p) => (
                <li class:list={["cc-card", { "cc-pick": p.pick, "cc-hide": p.hide }]}>
                  <a href={p.page} target="_blank" rel="noopener">
                    <img src={p.small.src} alt={p.caption} loading="lazy" />
                  </a>
                  <p class="cc-name">
                    {p.pick && "★ "}
                    {p.file}
                    {p.seen && <span class="cc-seen">見た</span>}
                    {p.hide && <span class="cc-seen">非公開</span>}
                  </p>
                  <p class="cc-caption">{p.caption}</p>
                  <p class="cc-meta">
                    {p.author} / {p.licenseUrl ? <a href={p.licenseUrl}>{licenseLabel(p)}</a> : licenseLabel(p)}
                    {p.date && ` / ${p.date}`}
                  </p>
                  {p.description && <p class="cc-desc">{p.description.slice(0, 160)}</p>}
                  {p.edited && <p class="cc-desc">加工：{p.edited}</p>}
                  {p.note && <p class="cc-note">{p.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section id="sources">
        <h2>Commons 以外</h2>
        <table>
          <thead>
            <tr><th>どこ</th><th>条件</th><th>メモ</th></tr>
          </thead>
          <tbody>
            {
              sources.map((s) => (
                <tr>
                  <td><a href={s.url} target="_blank" rel="noopener">{s.name}</a></td>
                  <td>{s.license}</td>
                  <td>{s.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p>くわしくは docs/notes/images.md と images-non-commons.md。</p>
      </section>
    </div>
  </article>
</Base>

<style>
  .cc-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }
  .cc-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .cc-card {
    margin: 0;
    padding: 8px;
    border: 1px solid var(--line, #ddd);
    border-radius: 4px;
  }
  .cc-hide {
    opacity: 0.55;
  }
  .cc-caption {
    color: var(--fg);
  }
  .cc-pick {
    border-color: var(--chart-1);
    border-width: 2px;
  }
  .cc-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
  .cc-card p {
    margin: 6px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .cc-name {
    font-weight: 700;
  }
  .cc-seen {
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 3px;
    background: var(--mark);
    font-weight: 400;
    font-size: 0.75rem;
  }
  .cc-desc {
    color: var(--mut);
  }
  .cc-note {
    color: var(--chart-2);
  }
</style>
