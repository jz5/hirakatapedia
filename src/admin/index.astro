---
/**
 * 管理者用ページ（/admin/）。`pnpm dev` のときだけある（astro.config.mjs の admin インテグレーション）。
 * 公開用のビルドには入らない。docs/checklist.md と docs/notes/ をそのまま見せる。
 */
import Base from "../layouts/Base.astro";

const docs = import.meta.glob<{ Content: any }>("../../docs/checklist.md", { eager: true });
const Checklist = Object.values(docs)[0].Content;

const raw = Object.values(
  import.meta.glob<string>("../../docs/checklist.md", { query: "?raw", import: "default", eager: true }),
)[0];
const open = (raw.match(/^\s*- \[ \]/gm) ?? []).length;
const done = (raw.match(/^\s*- \[x\]/gim) ?? []).length;

const notes = Object.keys(import.meta.glob("../../docs/notes/*.md"))
  .map((p) => p.split("/").pop()!.replace(/\.md$/, ""))
  .filter((n) => n !== "README")
  .sort();
---

<Base title="管理者ページ" path="/admin/" noindex>
  <article class="entry">
    <header class="entry-header">
      <h1>管理者ページ</h1>
      <p class="entry-meta">開発サーバーだけで見えるページです（公開されません）。まだ {open} 件、済み {done} 件。</p>
    </header>
    <div class="entry-body admin">
      <p><a href="/admin/photos/">写真の候補（自由ライセンス）</a></p>
      <h2>調べもののメモ</h2>
      <ul>
        {notes.map((n) => <li><a href={`/admin/notes/${n}/`}>{n}</a></li>)}
      </ul>
      <Checklist />
    </div>
  </article>
</Base>
